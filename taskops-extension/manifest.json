{
  "manifest_version": 3,
  "name": "TaskOps Overlay",
  "version": "1.1.0",
  "description": "Create and manage guided workflows without leaving the current webpage.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.execute-api.us-east-1.amazonaws.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TaskOps"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
